#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <250>;
            hold-trigger-on-release;
        };

        f8_vol_mute: f8_vol_mute {
            compatible = "zmk,behavior-mod-morph";
            label = "F8_VOL_MUTE";
            bindings = <&kp F8>, <&kp C_MUTE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        f9_vol_dn: f9_vol_dn {
            compatible = "zmk,behavior-mod-morph";
            label = "F9_VOL_DN";
            bindings = <&kp F9>, <&kp C_VOLUME_DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        f10_vol_up: f10_vol_up {
            compatible = "zmk,behavior-mod-morph";
            label = "F10_VOL_UP";
            bindings = <&kp F10>, <&kp C_VOLUME_UP>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        td_f6_play_pause: td_f6_play_pause {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_F6_PLAY_PAUSE";
            #binding-cells = <0>;
            bindings = <&kp F6>, <&kp C_PP>;
        };

        hm_shift: hm_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <150>;
            label = "HM_SHIFT";
        };

        td_mouse_esc: td_mouse_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MOUSE_ESC";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE>, <&tog 2>;
        };

        td_fn_esc: td_fn_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_FN_ESC";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE>, <&tog 1>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_braces {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <26 27>;
            layers = <0>;
        };

        combo_brackets {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <26 28>;
            layers = <0>;
        };

        mouse_layer {
            bindings = <&to 1>;
            key-positions = <22 23>;
            layers = <0>;
        };

        toggle_layer_fn {
            bindings = <&to 2>;
            key-positions = <23 21>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q       &kp W       &kp E        &kp R              &kp T            &kp Y         &kp U              &kp I        &kp O       &kp P
&hm LGUI A  &hm LALT S  &hm LCTRL D  &hm_shift LSHFT F  &kp G            &kp H         &hm_shift RSHFT J  &hm RCTRL K  &hm RALT L  &mt RGUI SEMICOLON
&mt CAPS Z  &kp X       &kp C        &kp V              &kp B            &kp N         &kp M              &kp COMMA    &kp PERIOD  &kp SLASH
                                     &kp SPACE          &kp BACKSPACE    &lt 1 ESCAPE  &kp ENTER
            >;
        };

        fn {
            bindings = <
&kp F1             &kp F2             &kp F3              &kp F4                    &kp F5    &td_f6_play_pause  &kp F7                &f8_vol_mute        &f9_vol_dn            &f10_vol_up
&hm LGUI NUMBER_1  &hm LALT NUMBER_2  &hm LCTRL NUMBER_3  &hm_shift LSHFT NUMBER_4  &kp N5    &kp LEFT_ARROW     &hm RSHFT DOWN_ARROW  &hm RCTRL UP_ARROW  &hm RALT RIGHT_ARROW  &hm RCMD F11
&kp N6             &kp N7             &kp N8              &kp N9                    &kp N0    &kp MINUS          &kp EQUAL             &kp SINGLE_QUOTE    &kp BACKSLASH         &kp GRAVE
                                                          &kp TAB                   &trans    &td_fn_esc         &kp F12
            >;
        };

        mouse {
            bindings = <
&kp NUMBER_2   &bootloader    &trans         &trans             &trans    &trans             &trans            &trans             &bootloader       &trans
&kp LG(SPACE)  &kp LA(SPACE)  &kp LA(LG(J))  &kp LS(LG(SPACE))  &trans    &mmv MOVE_X(-300)  &mmv MOVE_Y(300)  &mmv MOVE_Y(-300)  &mmv MOVE_X(300)  &trans
&trans         &trans         &trans         &trans             &trans    &msc SCRL_DOWN     &mkp LCLK         &mkp RCLK          &msc SCRL_UP      &trans
                                             &trans             &trans    &td_mouse_esc      &trans
            >;
        };

        bt {
            bindings = <
&kp NUMBER_3    &trans  &trans      &trans  &bt BT_SEL 0    &bt BT_SEL 3  &trans  &trans  &trans  &trans
&trans          &trans  &trans      &trans  &bt BT_SEL 1    &bt BT_SEL 4  &trans  &trans  &trans  &trans
&studio_unlock  &trans  &bt BT_CLR  &trans  &bt BT_SEL 2    &bt BT_CLR    &trans  &trans  &trans  &trans
                                    &trans  &trans          &to 0         &trans
            >;
        };

        right_layer {
            bindings = <
&kp NUMBER_4  &kp C_PP  &kp C_PREV    &kp C_NEXT    &kp LS(MINUS)    &kp MINUS  &kp N7  &kp N8  &kp N9  &trans
&kp ESCAPE    &gresc    &kp C_VOL_DN  &kp C_VOL_UP  &kp LS(EQUAL)    &kp EQUAL  &kp N4  &kp N5  &kp N6  &kp ENTER
&trans        &kp AMPS  &kp SLASH     &kp STAR      &kp DOT          &kp N0     &kp N1  &kp N2  &kp N3  &trans
                                      &kp TAB       &trans           &to 0      &trans
            >;
        };
    };
};

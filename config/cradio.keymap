#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv {
    time-to-max-speed-ms = <680>;
    acceleration-exponent = <2>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <250>;
            hold-trigger-on-release;
        };

        mm_left_inner: mm_left_inner {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_LEFT_INNER";
            bindings = <&kp LEFT>, <&mmv MOVE_X(-300)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mm_right_inner: mm_right_inner {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RIGHT_INNER";
            bindings = <&hm RALT RIGHT>, <&mmv MOVE_X(300)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mm_up_inner: mm_up_inner {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_UP_INNER";
            bindings = <&hm RCTRL UP_ARROW>, <&mmv MOVE_Y(-300)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mm_down_inner: mm_down_inner {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_DOWN_INNER";
            bindings = <&hm_shift RIGHT_SHIFT DOWN_ARROW>, <&mmv MOVE_Y(300)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mm_left: mm_left {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_LEFT";
            bindings = <&kp LEFT_ARROW>, <&mm_left_inner>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        mm_right: mm_right {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RIGHT";
            bindings = <&hm RALT RIGHT>, <&mm_right_inner>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        mm_up: mm_up {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_UP";
            bindings = <&hm RCTRL UP_ARROW>, <&mm_up_inner>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        mm_down: mm_down {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_DOWN";
            bindings = <&hm_shift RIGHT_SHIFT DOWN_ARROW>, <&mm_down_inner>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        mod_parens: mod_parens {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_PARENS";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_braces: mod_braces {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_BRACES";
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_brackets: mod_brackets {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_BRACKETS";
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f8_vol_mute: f8_vol_mute {
            compatible = "zmk,behavior-mod-morph";
            label = "F8_VOL_MUTE";
            bindings = <&kp F8>, <&kp C_MUTE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        f9_vol_dn: f9_vol_dn {
            compatible = "zmk,behavior-mod-morph";
            label = "F9_VOL_DN";
            bindings = <&kp F9>, <&kp C_VOLUME_DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        f10_vol_up: f10_vol_up {
            compatible = "zmk,behavior-mod-morph";
            label = "F10_VOL_UP";
            bindings = <&kp F10>, <&kp C_VOLUME_UP>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        mm_right_click: mm_right_click {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RIGHT_CLICK";
            bindings = <&mkp RCLK>, <&kp PAGE_UP>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_left_click: mm_left_click {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_LEFT_CLICK";
            bindings = <&mkp LCLK>, <&kp PAGE_DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td_f6_play_pause: td_f6_play_pause {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_F6_PLAY_PAUSE";
            #binding-cells = <0>;
            bindings = <&kp F6>, <&kp C_PP>;
        };

        hm_shift: hm_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <150>;
            label = "HM_SHIFT";
        };

        layer2: layer2 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER2";
            #binding-cells = <0>;
            bindings = <&kp X>, <&to 2>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_parens {
            bindings = <&mod_parens>;
            key-positions = <27 26>;
            layers = <0>;
        };

        combo_braces {
            bindings = <&mod_braces>;
            key-positions = <26 28>;
            layers = <0>;
        };

        combo_brackets {
            bindings = <&mod_brackets>;
            key-positions = <26 29>;
            layers = <0>;
        };

        mouse_layer {
            bindings = <&to 2>;
            key-positions = <22 23>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q       &kp W       &kp E        &kp R              &kp T            &kp Y         &kp U              &kp I        &kp O       &kp P
&hm LGUI A  &hm LALT S  &hm LCTRL D  &hm_shift LSHFT F  &kp G            &kp H         &hm_shift RSHFT J  &hm RCTRL K  &hm RALT L  &mt RGUI SEMICOLON
&mt CAPS Z  &kp X       &kp C        &kp V              &kp B            &kp N         &kp M              &kp COMMA    &kp PERIOD  &kp SLASH
                                     &kp SPACE          &kp BACKSPACE    &lt 1 ESCAPE  &kp ENTER
            >;
        };

        fn {
            bindings = <
&kp F1             &kp F2             &kp F3              &kp F4                    &kp F5     &td_f6_play_pause  &kp F7                &f8_vol_mute        &f9_vol_dn            &f10_vol_up
&hm LGUI NUMBER_1  &hm LALT NUMBER_2  &hm LCTRL NUMBER_3  &hm_shift LSHFT NUMBER_4  &kp N5     &kp LEFT_ARROW     &hm RSHFT DOWN_ARROW  &hm RCTRL UP_ARROW  &hm RALT RIGHT_ARROW  &hm RCMD F11
&kp N6             &kp N7             &kp N8              &kp N9                    &kp N0     &kp LA(LEFT)       &kp PAGE_DOWN         &kp PAGE_UP         &kp RA(RIGHT_ARROW)   &kp F12
                                                          &kp MINUS                 &kp TAB    &none              &kp EQUAL
            >;
        };

        mouse {
            bindings = <
&trans        &trans          &trans          &trans          &trans             &trans             &trans            &trans             &trans            &trans
&kp NUMBER_2  &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_DOWN  &mmv MOVE_RIGHT    &mmv MOVE_X(-300)  &mmv MOVE_Y(300)  &mmv MOVE_Y(-300)  &mmv MOVE_X(300)  &trans
&trans        &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT    &kp PAGE_DOWN      &mkp LCLK         &mkp RCLK          &kp PAGE_UP       &trans
                                              &trans          &trans             &tog 2             &trans
            >;
        };

        bt {
            bindings = <
&trans          &trans  &trans      &trans  &bt BT_SEL 0    &bt BT_SEL 3  &trans  &trans  &trans  &trans
&kp NUMBER_3    &trans  &trans      &trans  &bt BT_SEL 1    &bt BT_SEL 4  &trans  &trans  &trans  &trans
&studio_unlock  &trans  &bt BT_CLR  &trans  &bt BT_SEL 2    &bt BT_CLR    &trans  &trans  &trans  &trans
                                    &trans  &trans          &to 0         &trans
            >;
        };

        right_layer {
            bindings = <
&kp ESC       &kp C_PP  &kp C_PREV    &kp C_NEXT    &kp LS(MINUS)    &kp MINUS  &kp N7  &kp N8  &kp N9  &trans
&kp NUMBER_4  &gresc    &kp C_VOL_DN  &kp C_VOL_UP  &kp LS(EQUAL)    &kp EQUAL  &kp N4  &kp N5  &kp N6  &kp ENTER
&trans        &kp AMPS  &kp SLASH     &kp STAR      &kp DOT          &kp N0     &kp N1  &kp N2  &kp N3  &trans
                                      &trans        &kp TAB          &to 0      &trans
            >;
        };
    };
};

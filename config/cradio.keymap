#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <250>;
            hold-trigger-on-release;
        };

        hm_shift: hm_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <150>;
            label = "HM_SHIFT";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_braces {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <26 27>;
            layers = <0>;
        };

        combo_brackets {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <26 28>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q       &kp W       &kp E        &kp R              &kp T            &kp Y         &kp U              &kp I        &kp O       &kp P
&hm LGUI A  &hm LALT S  &hm LCTRL D  &hm_shift LSHFT F  &lt 2 G          &lt 2 H       &hm_shift RSHFT J  &hm RCTRL K  &hm RALT L  &mt RGUI SEMICOLON
&kp Z       &kp X       &kp C        &kp V              &kp B            &kp N         &kp M              &kp COMMA    &kp PERIOD  &kp SLASH
                                     &kp SPACE          &kp BACKSPACE    &lt 1 ESCAPE  &kp ENTER
            >;
        };

        fn {
            bindings = <
&kp F1             &kp F2             &kp F3              &kp F4                    &kp F5    &kp F6          &kp F7                &kp F8              &kp F9                &kp F10
&hm LGUI NUMBER_1  &hm LALT NUMBER_2  &hm LCTRL NUMBER_3  &hm_shift LSHFT NUMBER_4  &kp N5    &kp LEFT_ARROW  &hm RSHFT DOWN_ARROW  &hm RCTRL UP_ARROW  &hm RALT RIGHT_ARROW  &hm RCMD F11
&kp N6             &kp N7             &kp N8              &kp N9                    &kp N0    &kp MINUS       &kp EQUAL             &kp SINGLE_QUOTE    &kp GRAVE             &kp BACKSLASH
                                                          &kp TAB                   &trans    &trans          &kp F12
            >;
        };

        mouse {
            bindings = <
&kp CAPS       &trans         &trans         &trans             &trans    &kp C_PLAY_PAUSE   &kp C_STOP        &kp C_MUTE         &kp C_VOL_DN      &kp C_VOL_UP
&kp LG(SPACE)  &kp LA(SPACE)  &kp LA(LG(J))  &kp LS(LG(SPACE))  &trans    &mmv MOVE_X(-300)  &mmv MOVE_Y(300)  &mmv MOVE_Y(-300)  &mmv MOVE_X(300)  &kp PAGE_UP
&kp NUMBER_2   &trans         &trans         &trans             &trans    &msc SCRL_UP       &mkp LCLK         &mkp RCLK          &msc SCRL_DOWN    &kp PAGE_DOWN
                                             &bootloader        &trans    &trans             &bootloader
            >;
        };

        bt {
            bindings = <
&kp NUMBER_3    &trans  &trans      &trans  &bt BT_SEL 0    &bt BT_SEL 3  &trans  &trans  &trans  &trans
&trans          &trans  &trans      &trans  &bt BT_SEL 1    &bt BT_SEL 4  &trans  &trans  &trans  &trans
&studio_unlock  &trans  &bt BT_CLR  &trans  &bt BT_SEL 2    &bt BT_CLR    &trans  &trans  &trans  &trans
                                    &trans  &trans          &to 0         &trans
            >;
        };

        right_layer {
            bindings = <
&kp NUMBER_4  &kp C_PP  &kp C_PREV    &kp C_NEXT    &kp LS(MINUS)    &kp MINUS  &kp N7  &kp N8  &kp N9  &trans
&kp ESCAPE    &gresc    &kp C_VOL_DN  &kp C_VOL_UP  &kp LS(EQUAL)    &kp EQUAL  &kp N4  &kp N5  &kp N6  &kp ENTER
&trans        &kp AMPS  &kp SLASH     &kp STAR      &kp DOT          &kp N0     &kp N1  &kp N2  &kp N3  &trans
                                      &kp TAB       &trans           &to 0      &trans
            >;
        };
    };
};

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred";
    tapping_term_ms = <200>;
};

&mmv {
    time-to-max-speed-ms = <680>;
    acceleration-exponent = <2>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <250>;
            hold-trigger-on-release;
        };

        mm_left_inner: mm_left_inner {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_LEFT_INNER";
            bindings = <&kp LEFT>, <&mmv MOVE_X(-300)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mm_right_inner: mm_right_inner {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RIGHT_INNER";
            bindings = <&hm RALT RIGHT>, <&mmv MOVE_X(300)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mm_up_inner: mm_up_inner {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_UP_INNER";
            bindings = <&hm RCTRL UP_ARROW>, <&mmv MOVE_Y(-300)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mm_down_inner: mm_down_inner {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_DOWN_INNER";
            bindings = <&hm_shift RIGHT_SHIFT DOWN_ARROW>, <&mmv MOVE_Y(300)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mm_left: mm_left {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_LEFT";
            bindings = <&kp LEFT_ARROW>, <&mm_left_inner>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        mm_right: mm_right {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RIGHT";
            bindings = <&hm RALT RIGHT>, <&mm_right_inner>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        mm_up: mm_up {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_UP";
            bindings = <&hm RCTRL UP_ARROW>, <&mm_up_inner>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        mm_down: mm_down {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_DOWN";
            bindings = <&hm_shift RIGHT_SHIFT DOWN_ARROW>, <&mm_down_inner>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        mod_parens: mod_parens {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_PARENS";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_braces: mod_braces {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_BRACES";
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_brackets: mod_brackets {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_BRACKETS";
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f8_vol_mute: f8_vol_mute {
            compatible = "zmk,behavior-mod-morph";
            label = "F8_VOL_MUTE";
            bindings = <&kp F8>, <&kp C_MUTE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        f9_vol_dn: f9_vol_dn {
            compatible = "zmk,behavior-mod-morph";
            label = "F9_VOL_DN";
            bindings = <&kp F9>, <&kp C_VOLUME_DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        f10_vol_up: f10_vol_up {
            compatible = "zmk,behavior-mod-morph";
            label = "F10_VOL_UP";
            bindings = <&kp F10>, <&kp C_VOLUME_UP>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        mm_right_click: mm_right_click {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RIGHT_CLICK";
            bindings = <&mkp RCLK>, <&kp PAGE_UP>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_left_click: mm_left_click {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_LEFT_CLICK";
            bindings = <&mkp LCLK>, <&kp PAGE_DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td_f6_play_pause: td_f6_play_pause {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_F6_PLAY_PAUSE";
            #binding-cells = <0>;
            bindings = <&kp F6>, <&kp C_PP>;
        };

        hm_shift: hm_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <150>;
            label = "HM_SHIFT";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_parens {
            bindings = <&mod_parens>;
            key-positions = <27 26>;
        };

        combo_braces {
            bindings = <&mod_braces>;
            key-positions = <26 28>;
        };

        combo_brackets {
            bindings = <&mod_brackets>;
            key-positions = <26 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q               &kp W           &kp E        &kp R                   &kp T            &kp Y         &kp U              &kp I        &kp O            &kp P
&hm LEFT_COMMAND A  &hm LEFT_ALT S  &hm LCTRL D  &hm_shift LEFT_SHIFT F  &kp G            &kp H         &hm_shift RSHFT J  &hm RCTRL K  &hm RIGHT_ALT L  &mt RIGHT_COMMAND SEMICOLON
&mt CAPS Z          &kp X           &kp C        &kp V                   &kp B            &kp N         &kp M              &kp COMMA    &kp PERIOD       &kp SLASH
                                                 &kp SPACE               &kp BACKSPACE    &lt 1 ESCAPE  &kp ENTER
            >;
        };

        fn {
            bindings = <
&kp F1                     &kp F2                 &kp F3                     &kp F4                         &kp F5       &td_f6_play_pause  &kp F7          &f8_vol_mute     &f9_vol_dn           &f10_vol_up
&hm LEFT_COMMAND NUMBER_1  &hm LEFT_ALT NUMBER_2  &hm LEFT_CONTROL NUMBER_3  &hm_shift LEFT_SHIFT NUMBER_4  &kp N5       &mm_left           &mm_down        &mm_up           &mm_right            &hm RCMD F11
&kp N6                     &kp N7                 &kp N8                     &kp N9                         &kp N0       &kp LA(LEFT)       &mm_left_click  &mm_right_click  &kp RA(RIGHT_ARROW)  &kp F12
                                                                             &kp MINUS                      &kp EQUAL    &trans             &kp TAB
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans          &trans        &trans
&trans  &trans  &trans  &trans  &trans    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
&trans  &trans  &trans  &trans  &trans    &trans  &trans          &mkp LCLK       &mkp RCLK     &trans
                        &trans  &trans    &trans  &to 3
            >;
        };

        bt {
            bindings = <
&trans          &trans  &trans      &trans  &bt BT_SEL 0    &bt BT_SEL 3  &trans  &trans  &trans  &trans
&trans          &trans  &trans      &trans  &bt BT_SEL 1    &bt BT_SEL 4  &trans  &trans  &trans  &trans
&studio_unlock  &trans  &bt BT_CLR  &trans  &bt BT_SEL 2    &bt BT_CLR    &trans  &trans  &trans  &trans
                                    &to 0   &to 0           &trans        &to 1
            >;
        };

        right_layer {
            bindings = <
&kp ESC  &kp C_PP  &kp C_PREV    &kp C_NEXT    &kp LS(MINUS)    &kp MINUS  &kp N7  &kp N8  &kp N9  &trans
&kp TAB  &gresc    &kp C_VOL_DN  &kp C_VOL_UP  &kp LS(EQUAL)    &kp EQUAL  &kp N4  &kp N5  &kp N6  &kp ENTER
&to 3    &kp AMPS  &kp SLASH     &kp STAR      &kp DOT          &kp N0     &kp N1  &kp N2  &kp N3  &trans
                                 &trans        &to 0            &to 2      &to 3
            >;
        };

        extra_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };
    };
};

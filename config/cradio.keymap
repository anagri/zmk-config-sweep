#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred";
    tapping_term_ms = <200>;
};

&mmv {
    time-to-max-speed-ms = <680>;
    acceleration-exponent = <2>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td: tapdance {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        F9_voldn: F9_voldn {
            compatible = "zmk,behavior-mod-morph";
            label = "F9_VOLDN";
            bindings = <&kp F9>, <&kp C_VOL_DN>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        f10_volup: f10_volup {
            compatible = "zmk,behavior-mod-morph";
            label = "F10_VOLUP";
            bindings = <&kp F10>, <&kp C_VOLUME_UP>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        f8_volmt: f8_volmt {
            compatible = "zmk,behavior-mod-morph";
            label = "F8_VOLMT";
            bindings = <&kp F8>, <&kp C_MUTE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        mute_vol_dn: mute_vol_dn {
            compatible = "zmk,behavior-hold-tap";
            label = "MUTE_VOL_DN";
            bindings = <&f8_volmt>, <&F9_voldn>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            flavor = "tap-preferred";
        };

        mm_left_inner: mm_left_inner {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_LEFT_INNER";
            bindings = <&kp LEFT>, <&mmv MOVE_X(-300)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mm_right_inner: mm_right_inner {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RIGHT_INNER";
            bindings = <&hm RALT RIGHT>, <&mmv MOVE_X(300)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mm_up_inner: mm_up_inner {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_UP_INNER";
            bindings = <&hm RCTRL UP_ARROW>, <&mmv MOVE_Y(-300)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mm_down_inner: mm_down_inner {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_DOWN_INNER";
            bindings = <&hm RIGHT_SHIFT DOWN_ARROW>, <&mmv MOVE_Y(300)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mm_left: mm_left {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_LEFT";
            bindings = <&kp LEFT_ARROW>, <&mm_left_inner>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        mm_right: mm_right {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_RIGHT";
            bindings = <&hm RALT RIGHT>, <&mm_right_inner>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-mod-morph";
            label = "NEW_BEHAVIOR";
            bindings = <&hm RCTRL UP_ARROW>, <&mm_up_inner>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        mm_up: mm_up {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_UP";
            bindings = <&hm RCTRL UP_ARROW>, <&mm_up_inner>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        mm_down: mm_down {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_DOWN";
            bindings = <&hm RIGHT_SHIFT DOWN_ARROW>, <&mm_down_inner>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        mod_paren: mod_paren {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_PAREN";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_brace: mod_brace {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_BRACE";
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_brackets: mod_brackets {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_BRACKETS";
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_parens {
            bindings = <&mod_paren>;
            key-positions = <27 26>;
        };

        combo_braces {
            bindings = <&mod_brace>;
            key-positions = <26 28>;
        };

        combo_brackets {
            bindings = <&mod_brackets>;
            key-positions = <26 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q               &kp W           &kp E        &kp R             &kp T            &kp Y         &kp U        &kp I        &kp O            &kp P
&hm LEFT_COMMAND A  &hm LEFT_ALT S  &hm LCTRL D  &hm LEFT_SHIFT F  &kp G            &kp H         &hm RSHFT J  &hm LCTRL K  &hm RIGHT_ALT L  &mt RIGHT_COMMAND SEMICOLON
&mt CAPS Z          &kp X           &kp C        &kp V             &kp B            &kp N         &kp M        &kp COMMA    &kp PERIOD       &kp SLASH
                                                 &kp SPACE         &kp BACKSPACE    &lt 1 ESCAPE  &kp RET
            >;
        };

        left_layer {
            bindings = <
&kp F1                     &kp F2                 &kp F3                     &kp F4                   &kp F5    &kp F6        &kp F7        &kp F8     &kp F9     &kp F10
&hm LEFT_COMMAND NUMBER_1  &hm LEFT_ALT NUMBER_2  &hm LEFT_CONTROL NUMBER_3  &hm LEFT_SHIFT NUMBER_4  &kp N5    &mm_left      &mm_down      &mm_up     &mm_right  &hm LEFT_COMMAND F11
&kp N6                     &kp N7                 &kp N8                     &kp N9                   &kp N0    &kp LA(LEFT)  &kp LA(LEFT)  &kp COMMA  &kp DOT    &kp F12
                                                                             &trans                   &trans    &to 0         &to 2
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans          &trans        &trans
&trans  &trans  &trans  &trans  &trans    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
&trans  &trans  &trans  &trans  &trans    &trans  &trans          &mkp LCLK       &mkp RCLK     &trans
                        &trans  &trans    &trans  &to 3
            >;
        };

        bt {
            bindings = <
&trans          &trans  &trans      &trans  &bt BT_SEL 0    &bt BT_SEL 3  &trans  &trans  &trans  &trans
&trans          &trans  &trans      &trans  &bt BT_SEL 1    &bt BT_SEL 4  &trans  &trans  &trans  &trans
&studio_unlock  &trans  &bt BT_CLR  &trans  &bt BT_SEL 2    &bt BT_CLR    &trans  &trans  &trans  &trans
                                    &to 0   &to 0           &trans        &to 1
            >;
        };

        right_layer {
            bindings = <
&kp ESC  &kp C_PP  &kp C_PREV    &kp C_NEXT    &kp LS(MINUS)    &kp MINUS  &kp N7  &kp N8  &kp N9  &trans
&kp TAB  &gresc    &kp C_VOL_DN  &kp C_VOL_UP  &kp LS(EQUAL)    &kp EQUAL  &kp N4  &kp N5  &kp N6  &kp ENTER
&to 3    &kp AMPS  &kp SLASH     &kp STAR      &kp DOT          &kp N0     &kp N1  &kp N2  &kp N3  &trans
                                 &trans        &to 0            &to 2      &to 3
            >;
        };

        extra_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };
    };
};
